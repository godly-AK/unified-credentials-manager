# Bare public DNS hostname, without https:// or a path.
UCM_DOMAIN=ucm.example.com
# Generate two independent secrets; keep the real .env outside version control.
UCM_DB_PASSWORD=replace-with-random-url-safe-password
# Base64 of exactly 32 random bytes. Never rotate without a data migration plan.
UCM_DATA_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes
# Keep disabled until the physical three-phone acceptance test passes.
UCM_OFFICE_TRUST_ENABLED=false

# Set these only when adding monitoring.yaml. Use distinct random values.
UCM_ELASTIC_PASSWORD=replace-with-20-or-more-url-safe-random-characters
UCM_KIBANA_PASSWORD=replace-with-20-or-more-url-safe-random-characters
UCM_KIBANA_SAVED_OBJECTS_KEY=replace-with-at-least-32-random-characters
UCM_KIBANA_SECURITY_KEY=replace-with-at-least-32-different-random-characters
UCM_KIBANA_REPORTING_KEY=replace-with-at-least-32-different-random-characters
